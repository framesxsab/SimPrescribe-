APP_NAME=SimpliScribe
APP_ENV=development
DATABASE_URL=sqlite:///data/simpliscribe.db
SESSION_SECRET=development-only-change-me
AUTH_REQUIRED=false
ADMIN_EMAIL=admin@localhost
# Set this only in your local .env or deployment secret manager; never commit a real password.
ADMIN_PASSWORD=
RETENTION_DAYS=30
SESSION_MAX_AGE_SECONDS=28800
SESSION_HTTPS_ONLY=false
HUGGINGFACEHUB_API_TOKEN=
HF_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
INFERENCE_PROVIDER=fallback
MODEL_API_URL=
MODEL_API_KEY=
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=10
MAX_IMAGE_PIXELS=40000000
MIN_OCR_CONFIDENCE=0.80
REQUEST_TIMEOUT_SECONDS=60
OCR_LANGUAGE=en
OCR_USE_GPU=false
LOCAL_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
LOCAL_MODEL_DEVICE=auto
LOCAL_MODEL_TEMPERATURE=0.1
LOCAL_MODEL_MAX_NEW_TOKENS=256
LOCAL_MODEL_TRUST_REMOTE_CODE=false
