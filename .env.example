APP_NAME=SimpliScribe
APP_ENV=development
DATABASE_URL=sqlite:///data/simpliscribe.db
SESSION_SECRET=development-only-change-me
AUTH_REQUIRED=false
ADMIN_EMAIL=admin@localhost
# Set this only in your local .env or deployment secret manager; never commit a real password.
ADMIN_PASSWORD=
# Bootstrap-only role. External identity is required before multi-user use.
ADMIN_ROLE=admin
# Optional managed identity. Configure all four values together in deployment secrets.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# Comma-separated immutable provider subject IDs. Other signed-in users are read-only auditors.
OIDC_ADMIN_SUBJECTS=
OIDC_REVIEWER_SUBJECTS=
RETENTION_DAYS=30
SESSION_MAX_AGE_SECONDS=28800
SESSION_HTTPS_ONLY=false
HUGGINGFACEHUB_API_TOKEN=
HF_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
INFERENCE_PROVIDER=fallback
MODEL_API_URL=
MODEL_API_KEY=
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=10
MAX_IMAGE_PIXELS=40000000
MIN_OCR_CONFIDENCE=0.80
REQUEST_TIMEOUT_SECONDS=60
OCR_LANGUAGE=en
OCR_USE_GPU=false
LOCAL_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
LOCAL_MODEL_DEVICE=auto
LOCAL_MODEL_TEMPERATURE=0.1
LOCAL_MODEL_MAX_NEW_TOKENS=256
LOCAL_MODEL_TRUST_REMOTE_CODE=false
# Alternative medicine reference candidates. OFF by default (fail-closed): when
# enabled, only the canonical medicine name is sent to the configured model and/or
# DuckDuckGo when the local datasets provide no substitutes for a medicine.
ALTERNATIVES_ENABLED=false
# auto = model knowledge first (when a model provider is set), then DuckDuckGo.
# Also accepts: model, web, duckduckgo
ALTERNATIVES_PROVIDER=auto
ALTERNATIVES_TIMEOUT_SECONDS=15
ALTERNATIVES_CACHE_TTL_SECONDS=86400
ALTERNATIVES_MAX_CANDIDATES=5
# Rate-limit keying: enable ONLY behind a trusted proxy that strips inbound
# X-Forwarded-For (otherwise the header is spoofable and the limit can be bypassed).
TRUST_PROXY_HEADERS=false
# Optional shared secret for the local model server /extract endpoint (sent as
# Authorization: Bearer). Empty = no auth; keep the server bound to 127.0.0.1.
MODEL_SERVER_API_KEY=
MODEL_SERVER_MAX_INPUT_CHARS=20000
